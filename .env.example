# Database credentials: use unique values for each environment.
POSTGRES_DB=client_management
POSTGRES_USER=client_app
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DB_HOST=database
DB_PORT=5432

# Initial administrator: no default credentials are shipped.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-12-characters
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-output-from-openssl-rand-hex-32

# Set true only when the portal is served through HTTPS.
COOKIE_SECURE=false
